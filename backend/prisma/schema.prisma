generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  name       String
  isApproved Boolean   @default(true)
  isAdmin    Boolean   @default(false)
  zoomLevel              Int       @default(50)
  notificationsReadAt    DateTime?
  lastLoginAt            DateTime?
  loginCount             Int       @default(0)
  createdAt              DateTime  @default(now())
  defaultBubbleId      Int?
  contents   Content[]
  reviews    Review[]
  votes      Vote[]
  passwordResetTokens  PasswordResetToken[]
  bubbleMemberships    BubbleMembership[]
  bubblesCreated       Bubble[]           @relation("BubbleCreator")
  bubbleInvitesSent    BubbleInvitation[] @relation("BubbleInviter")
  stories              Story[]
  aiPrompts            AiPrompt[]
}

// Storic — outil de création d'histoires. Espace strictement privé : une histoire
// n'est visible que par son auteur.
model Story {
  id        Int      @id @default(autoincrement())
  title     String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  premises        Premise[]
  depths          Depth[]
  problems        Problem[]
  principles      Principle[]
  characters      Character[]
  conflicts       Conflict[]
  sequences       Sequence[]
  transformations Transformation[]
  dilemmas        Dilemma[]
  receptions      Reception[]
}

// Toutes les étapes du pipeline d'écriture ont la même forme : un texte, une
// note de 0 à 20, rattachés à une histoire. Depth = profondeur / fertilité ;
// les suivantes suivent la méthode (problèmes, principe directeur, personnage,
// conflit, séquence de cause à effet, transformation, dilemme, réception).
model Depth {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Problem {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Principle {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conflict {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sequence {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transformation {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dilemma {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reception {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Une prémisse candidate pour une histoire. Note de 0 à 20, 10 par défaut.
model Premise {
  id        Int      @id @default(autoincrement())
  text      String
  score     Int      @default(10)
  storyId   Int
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Prompt IA éditable par l'utilisateur. Une ligne par (utilisateur, clé).
// Si absente, le prompt par défaut du code s'applique.
model AiPrompt {
  id        Int      @id @default(autoincrement())
  key       String
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// Journal des appels à l'IA : une ligne par appel, pour la page Coûts IA.
model AiCall {
  id           Int      @id @default(autoincrement())
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  userId       Int?
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Content {
  id          Int       @id @default(autoincrement())
  title       String
  author      String?
  coverImage  String
  summary     String?
  whyRead     String
  rating      Float
  sponsor     String
  support     String?
  genre       String?
  url         String?
  publishDate DateTime?
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  bubbleId    Int?
  bubble      Bubble?   @relation("ContentLegacyBubble", fields: [bubbleId], references: [id])
  bubbles     ContentBubble[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviews     Review[]
  votes       Vote[]
}

model Bubble {
  id             Int                @id @default(autoincrement())
  name           String
  createdAt      DateTime           @default(now())
  createdById    Int
  createdBy      User               @relation("BubbleCreator", fields: [createdById], references: [id])
  members        BubbleMembership[]
  contents       Content[]          @relation("ContentLegacyBubble")
  contentBubbles ContentBubble[]
  invitations    BubbleInvitation[]
}

model ContentBubble {
  id        Int     @id @default(autoincrement())
  contentId Int
  bubbleId  Int
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  bubble    Bubble  @relation(fields: [bubbleId], references: [id], onDelete: Cascade)
  @@unique([contentId, bubbleId])
}

model BubbleMembership {
  id        Int      @id @default(autoincrement())
  userId    Int
  bubbleId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bubble    Bubble   @relation(fields: [bubbleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, bubbleId])
}

model BubbleInvitation {
  id          Int      @id @default(autoincrement())
  token       String   @unique
  email       String
  bubbleId    Int
  invitedById Int
  bubble      Bubble   @relation(fields: [bubbleId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("BubbleInviter", fields: [invitedById], references: [id])
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Tag {
  id        Int      @id @default(autoincrement())
  type      String   // "support" ou "genre"
  value     String
  createdAt DateTime @default(now())
  @@unique([type, value])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Float
  comment   String
  userId    Int
  contentId Int
  user      User     @relation(fields: [userId], references: [id])
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model Vote {
  id        Int      @id @default(autoincrement())
  type      String   // "UP" | "DOWN"
  userId    Int
  contentId Int
  user      User     @relation(fields: [userId], references: [id])
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}
